# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Core Flask ---
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=

# --- Telegram bot integration ---
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
# 2. Paste the token it gives you here.
TELEGRAM_BOT_TOKEN=
# The bot's @username, no leading @ (e.g. SahananethBot)
TELEGRAM_BOT_USERNAME=
# Any long random string — protects the webhook endpoint from spoofed requests.
# Only needed if you deploy with a public URL (e.g. Render) and use webhook mode.
TELEGRAM_WEBHOOK_SECRET=change-this-to-a-long-random-string
